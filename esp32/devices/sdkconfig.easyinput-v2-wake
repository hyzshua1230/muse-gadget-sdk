CONFIG_SR_WN_WN9_NIHAOXIAOYI_TTS2=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_ESP_SR_EXTERNAL_MODEL_PATH=""
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_easyinput_v2_wake.csv"
